# Copy to `.env` and fill in real values. `.env` is git-ignored.
# In production these come from Docker secrets or Oracle Vault instead.

# MetaTrader 5 (local Windows bridge only)
MT5_LOGIN=0
MT5_PASSWORD=change-me
MT5_SERVER=DerivSVG-Server-03

# Deriv API
DERIV_API_TOKEN=change-me

# Telegram alerts
TELEGRAM_TOKEN=change-me
TELEGRAM_CHAT_ID=0

# Safety: simulated fills through the full pipeline (go-live flips this)
DRY_RUN_MODE=true

# API gateway operator credentials (POST /token)
GATEWAY_USERNAME=vix-admin
GATEWAY_PASSWORD=change-me-gateway
